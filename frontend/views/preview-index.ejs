<%- include('partials/head') %>
<main id="main" class="page">
<h1>Frontend screens</h1><p class="muted">Local presentation previews. Account, resource and capacity records are unavailable.</p>
<% for (const group of groups) { %>
<section><h2><%= group.label %></h2><ul class="screen-links">
<% for (const [label,href] of group.links) { %><li><a href="<%= href %>"><%= label %></a></li><% } %>
</ul></section><% } %>
</main></body></html>

