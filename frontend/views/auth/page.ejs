<%- include('../partials/head') %>
<header class="auth-brand"><a class="brand" href="/">CortexOps</a></header>
<main id="main" class="auth-main <%= key === 'two-factor/setup' || key === 'verification-result' ? 'auth-wide' : '' %>">
<section class="auth-card" aria-labelledby="auth-title"><h1 id="auth-title"><%= title %></h1><p class="muted"><%= description %></p>
<p class="notice small spaced">Frontend preview · Authentication services unavailable</p>
<% const errorMessages = {
  invalid: key === 'login' ? 'Email or password is incorrect. Check your details and try again.' : 'That code is not valid. Check your app and enter the new code.',
  expired: 'That code has expired. Enter the current code from your authenticator app.'
}; %>
<% if ((key === 'login' || key === 'two-factor/verify') && Object.hasOwn(errorMessages, state)) { %>
  <div class="notice error-notice"><p class="small">Design error state preview</p><p><%= errorMessages[state] %></p></div>
<% } %>
<% if (key === 'verification-result') { %>
<div class="verification-grid"><% for (const [heading,message] of [['Email verified','Your account is ready. Sign in to continue.'],['This link has expired','Request a new verification link.'],['This link is not valid','Use the most recent verification email.'],['Your email is already verified','Sign in to continue.']]) { %>
<article class="panel"><p class="muted small">Design state preview</p><h3><%= heading %></h3><p><%= message %></p><a href="/preview/auth/login">Back to sign in</a></article><% } %></div>
<% } else if (key === 'verify-email' || key === 'check-email') { %>
<button class="full-width spaced" disabled><%= key === 'verify-email' ? 'Resend verification email' : 'Resend reset link' %></button>
<p class="muted small spaced">Email delivery is unavailable. No message has been sent.</p>
<% if (key === 'verify-email') { %><p class="spaced"><a href="/preview/auth/verification-result">View verification result screens</a></p><% } %>
<% } else { %>
<% if (key === 'two-factor/setup') { %><div class="setup-grid spaced"><div><div class="qr-placeholder">QR code unavailable</div><p class="muted small">Manual setup key</p><code>NOT-PROVISIONED</code></div><ol><li>Install an authenticator app.</li><li>Scan the QR code or enter the setup key.</li><li>Enter the six-digit code.</li></ol></div><% } %>
<form data-local-form method="dialog" class="spaced"><fieldset disabled data-form-fields>
<div class="auth-field-grid">
<% for (const field of fields) { %><%- include('../partials/field', { field }) %><% } %>
</div>
<% if (key === 'login') { %><p class="align-right"><a href="/preview/auth/forgot-password">Forgot password?</a></p><% } %>
<p class="form-feedback" role="status"></p><button type="submit" class="full-width spaced">Check fields</button><button class="primary full-width spaced" disabled><%= actionLabel %></button>
</fieldset></form>
<% } %>
<% if (key === 'login') { %><p class="auth-footer">New to CortexOps? <a href="/preview/auth/register">Create an account</a></p>
<% } else { %><p class="auth-footer"><a href="/preview/auth/login">Back to sign in</a></p><% } %>
<noscript><p class="muted small spaced">Enable JavaScript to try local validation.</p></noscript>
</section>
<p class="auth-footer muted">No account actions are sent</p>
<% if (key === 'login' || key === 'two-factor/verify') { %>
<nav class="auth-preview-links" aria-label="Error state previews"><a href="?state=invalid">Invalid <%= key === 'login' ? 'credentials' : 'code' %></a><% if (key !== 'login') { %><a href="?state=expired">Expired code</a><% } %><a href="?">Default state</a></nav>
<% } %>
<nav class="auth-preview-links" aria-label="Authentication preview screens">
<a href="/preview/auth/login">Sign in</a><a href="/preview/auth/register">Register</a><a href="/preview/auth/verify-email">Email verification</a><a href="/preview/auth/two-factor/setup">2FA setup</a><a href="/preview/auth/two-factor/verify">2FA sign-in</a><a href="/preview/auth/reset-password">Reset password</a>
</nav></main></body></html>

