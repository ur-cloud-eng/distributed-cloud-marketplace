<%- include('head') %>
<header class="site-header"><a class="brand" href="/">CortexOps</a><nav aria-label="Main navigation"><a href="/">Home</a><a href="/services">Services</a><a href="/pricing">Pricing</a><a href="/about">About</a><a href="/contact">Contact</a></nav><div><a class="button" href="/login">Sign in</a> <a class="button primary" href="/register">Get started</a></div></header>
<main id="main" class="site-main">
<% if(url === '/') { %>
<section class="hero"><div><p class="eyebrow">Distributed cloud marketplace</p><h1>Cloud resources, made accessible.</h1><p>Find simulated computing, storage, networking and database resources from participating providers. Manage your infrastructure and costs in one place.</p><div class="hero-actions"><a class="button primary" href="/register">Create an account</a><a class="button" href="/services">Explore services</a></div></div><div class="hero-panel"><p class="eyebrow">One platform. Three portals.</p><h3>Customers</h3><p>Build and manage cloud resources.</p><h3>Providers</h3><p>Offer capacity and track earnings.</p><h3>Administrators</h3><p>Monitor operations and finances.</p></div></section>
<section><h2>Explore CortexOps</h2><div class="site-grid"><article class="panel"><h3>Infrastructure</h3><p>Eleven resource types for your environment.</p><a href="/services">View services</a></article><article class="panel"><h3>Transparent billing</h3><p>Usage-based invoices and simulated payments.</p><a href="/pricing">Explore pricing</a></article><article class="panel"><h3>Architecture advisor</h3><p>Get a suggested resource plan based on your requirements.</p><a href="/login">Sign in to use</a></article></div></section>
<% } else if(url === '/services') { %><h1>Cloud services</h1><p class="muted">Eleven resource types. Create resources after signing in.</p><div class="site-grid spaced"><% for(const resource of resourceTypes) { %><article class="panel"><p class="eyebrow"><%= resource.category %></p><h3><%= resource.label %></h3><p><%= resource.description %></p></article><% } %></div>
<% } else if(url === '/pricing') { %><h1>Pricing</h1><p class="muted">Choose from Economy, Business and Critical hosting classes. Actual rates and estimates are available in your account.</p><div class="site-grid spaced"><% for(const name of ['Economy','Business','Critical']) { %><article class="panel"><h3><%= name %></h3><p>View the current rates and estimated resource costs in your customer portal.</p></article><% } %></div><p class="spaced"><a class="button primary" href="/login">Sign in to estimate costs</a></p>
<% } else if(url === '/about') { %><h1>About CortexOps</h1><p>CortexOps is a university cloud marketplace project connecting customers who need simulated cloud resources with providers who register available capacity.</p><div class="site-grid spaced"><article class="panel"><h3>Customers</h3><p>Organize, create and manage resources.</p></article><article class="panel"><h3>Providers</h3><p>Register hosts and manage available capacity.</p></article><article class="panel"><h3>Platform</h3><p>Coordinate resource allocation, usage billing and financial oversight.</p></article></div><% } else { %><h1>Contact</h1><p>For account or project support, contact the CortexOps project team through your course or existing communication channel.</p><p class="notice spaced">A public support email and contact submission service have not been configured.</p><a class="button spaced" href="/login">Go to your account</a><% } %>
</main><footer class="site-footer"><span>CortexOps · University cloud marketplace</span><a href="/about">About</a><a href="/contact">Contact</a></footer></body></html>
