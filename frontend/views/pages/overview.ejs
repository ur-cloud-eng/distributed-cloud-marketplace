<dl class="metrics metrics-<%= metrics.length %>">
<% for (const label of metrics) { %><div><dt><%= label %></dt><dd aria-label="Unavailable">—</dd></div><% } %></dl>
<% if (role === 'customer') { %>
<section aria-labelledby="environments"><div class="section-heading"><h2 id="environments">Environments</h2><a href="<%= base %>/dependencies">View dependencies</a></div>
<div class="panel"><%- include('../partials/unavailable', { heading: 'Resource groups unavailable', message: 'Your environments and resource hierarchies will appear here when connected.' }) %></div></section>
<% } else if (role === 'provider') { %>
<section aria-labelledby="capacity"><h2 id="capacity">Capacity by host</h2><div class="panel"><%- include('../partials/unavailable', { heading: 'Host capacity unavailable', message: 'CPU, RAM and disk usage require the existing host and allocation records.' }) %></div></section>
<% } else { %>
<section aria-labelledby="attention"><h2 id="attention">Needs attention</h2><div class="panel"><%- include('../partials/unavailable', { heading: 'Platform status unavailable', message: 'Platform alerts require audit, user and resource records.' }) %></div></section>
<% } %>
<section aria-labelledby="recent-activity"><div class="section-heading"><h2 id="recent-activity">Recent activity</h2><a href="<%= base %>/activity">View all activity</a></div>
<%- include('../partials/table', { caption: 'Recent activity', columns }) %></section>

