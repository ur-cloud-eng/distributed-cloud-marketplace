<%- include('partials/head') %>
<%- include('partials/navbar') %>
<%- include('partials/preview') %>
<main class="page" id="main">
<% if (breadcrumbs.length) { %><nav class="breadcrumbs" aria-label="Breadcrumb"><ol>
<% for (const [label,href] of breadcrumbs) { %><li><a href="<%= href %>"><%= label %></a></li><% } %>
<li aria-current="page"><%= title %></li></ol></nav><% } %>
<div class="page-heading"><div><h1><%= title %></h1><p class="muted"><%= description %></p></div>
<% if (action) { %><a class="button primary" href="<%= action[1] %>"><%= action[0] %></a><% } %>
</div>
<%- include(template) %>
</main></body></html>

